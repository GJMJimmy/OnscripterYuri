# systemd unit for the onsyuri save-sync server
#
# install:
#   sudo mkdir -p /opt/onsyuri-sync
#   sudo cp onsyuri_sync_server.py /opt/onsyuri-sync/
#   sudo cp onsyuri_sync_server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now onsyuri-sync
#   journalctl -u onsyuri-sync -f        # follow logs
#
# behind a reverse proxy (https termination), bind localhost instead:
#   ExecStart=... --host 127.0.0.1 ...

[Unit]
Description=OnscripterYuri save-sync server
After=network.target

[Service]
WorkingDirectory=/opt/onsyuri-sync
ExecStart=/usr/bin/python3 /opt/onsyuri-sync/onsyuri_sync_server.py --port 8765 --dir /var/lib/onsyuri-sync
Restart=on-failure
RestartSec=3

# run as an ephemeral system user; saves live in /var/lib/onsyuri-sync
# (created and ownership-managed by systemd, survives restarts/updates)
DynamicUser=yes
StateDirectory=onsyuri-sync

# hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/onsyuri-sync

[Install]
WantedBy=multi-user.target
